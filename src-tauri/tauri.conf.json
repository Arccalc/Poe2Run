{
  "productName": "PoE2SpeedrunTimer",
  "version": "0.1.1",
  "identifier": "com.poe2speedrun.timer",
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoE 2 Speedrun Timer",
        "width": 360,
        "height": 650,
        "minWidth": 150,
        "minHeight": 40,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/Arccalc/Poe2Run/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMjQ0NzA4OEVCQkJFNUMKUldSY3ZydU9DRWNrVTR6cmtMK1A3Z3FkWlA3QzhJYkp0SzdmL3VXaXhVd2dXdExOOWE2VXIwNVUK"
    }
  }
}
